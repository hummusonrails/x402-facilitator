# Facilitator this app settles through (server-only)
FACILITATOR_URL=http://localhost:3002
# API key issued to your merchant account, sent only on /settle (server-only, never NEXT_PUBLIC_)
MERCHANT_API_KEY=your_api_key_here
# CAIP-2 network the facilitator is configured for: eip155:421614 (Arbitrum Sepolia) or eip155:42161 (Arbitrum One)
NETWORK=eip155:421614
